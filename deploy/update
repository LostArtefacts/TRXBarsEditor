#!/bin/sh
# /srv/bars-editor/update on the server, owned by root. It is the forced
# command of the deploy key of svc-bars-editor, so CI runs it as
#
#   ssh svc-bars-editor@tomb <commit> < static.tar.gz
#
# It unpacks the editor CI built from <commit> into www/<commit> and points
# www/current, which nginx serves at lostartefacts.dev/pub/bars-editor/, at
# it. It keeps the last three builds.
set -eu

commit=${SSH_ORIGINAL_COMMAND:-}
if ! printf '%s' "$commit" | grep -Eqx '[0-9a-f]{40}'; then
    echo "usage: ssh $(id -un)@<host> <commit> < static.tar.gz" >&2
    exit 2
fi

cd "$HOME/www"
new=$(mktemp -d .new.XXXXXX)
trap 'rm -rf "$new"' EXIT
tar -xzf - -C "$new" --no-same-owner --no-same-permissions
if [ ! -f "$new/index.html" ]; then
    echo "the build has no index.html" >&2
    exit 1
fi
chmod -R u=rwX,g=rX,o= "$new"
rm -rf "$commit"
mv "$new" "$commit"
trap - EXIT
ln -sfn "$commit" current.new
mv -T current.new current

find . -mindepth 1 -maxdepth 1 -type d \
    -regextype posix-extended -regex '\./[0-9a-f]{40}' -printf '%T@ %p\n' |
    sort -rn | tail -n +4 | cut -d' ' -f2- | xargs -r rm -rf
echo "deployed $commit"
